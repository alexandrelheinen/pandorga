# Optional. Copy to studio-mobile/.env (gitignored).
# Local `npx expo start` only. EAS release uses eas.json `env` (or secrets).
STUDIO_WEB_APP_URL=http://127.0.0.1:4000/studio/

# Optional display name (default: Studio).
STUDIO_APP_NAME=

# Optional Android applicationId (default: com.example.pandorga.studio).
# STUDIO_ANDROID_PACKAGE takes precedence over ANDROID_PACKAGE.
STUDIO_ANDROID_PACKAGE=
# ANDROID_PACKAGE=

# Optional override after `npx eas init`. Leave empty until you have a UUID.
EAS_PROJECT_ID=
